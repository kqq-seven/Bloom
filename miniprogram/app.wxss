page {
  min-height: 100%;
  background: #fdf7f3;
  color: #302925;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view, text, button, input, picker, textarea {
  box-sizing: border-box;
}

button::after { border: 0; }

.page-shell {
  min-height: 100vh;
  padding: 30rpx 30rpx 50rpx;
  padding-bottom: calc(50rpx + env(safe-area-inset-bottom));
}

.brand { color: #894838; }
.muted { color: #806f68; }
.eyebrow { color: #527064; font-size: 20rpx; letter-spacing: 3rpx; font-weight: 700; }
.title { font-size: 46rpx; line-height: 1.25; font-weight: 700; }
.section-title { margin: 32rpx 0 18rpx; font-size: 32rpx; font-weight: 700; }
.card {
  margin-top: 20rpx;
  padding: 26rpx;
  border-radius: 26rpx;
  background: #fffdfa;
  box-shadow: 0 8rpx 28rpx rgba(74, 47, 35, .045);
}
.soft-card { background: #f7eee8; border-radius: 26rpx; padding: 25rpx; }
.row { display: flex; align-items: center; gap: 16rpx; }
.between { justify-content: space-between; }
.stack { display: flex; flex-direction: column; gap: 18rpx; }
.pill {
  display: inline-flex;
  align-items: center;
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  background: #f2e7df;
  color: #745d53;
  font-size: 20rpx;
}
.pill-mint { background: #dcefe5; color: #456557; }
.pill-rose { background: #f8ded6; color: #8a493b; }
.primary {
  min-height: 88rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: #894838;
  color: white;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 88rpx;
}
.secondary {
  min-height: 76rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #f0e5de;
  color: #754c3f;
  font-size: 25rpx;
  line-height: 76rpx;
}
.field-label { display: block; margin: 18rpx 0 10rpx; font-weight: 650; }
.input {
  width: 100%;
  height: 90rpx;
  padding: 0 24rpx;
  border: 1rpx solid #eadbd3;
  border-radius: 20rpx;
  background: #fff;
}
.hint { margin-top: 12rpx; color: #897a73; font-size: 22rpx; line-height: 1.55; }
.error { color: #9e4235; }
.empty-state { padding: 48rpx 28rpx; text-align: center; }
.empty-state-title { font-size: 34rpx; font-weight: 650; }
.empty-state-copy { display: block; margin: 15rpx 0 24rpx; color: #806f68; line-height: 1.6; }
