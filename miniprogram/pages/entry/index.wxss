.page-title { margin: 10rpx 0 30rpx; font-size: 46rpx; font-weight: 700; }
.field-label { display: block; margin: 22rpx 0 10rpx; font-size: 25rpx; font-weight: 650; }
.input, .textarea { width: 100%; min-height: 88rpx; padding: 20rpx 22rpx; border: 1rpx solid #eadbd3; border-radius: 18rpx; background: #fffdfa; }
.textarea { min-height: 240rpx; }
.picker-value { display: flex; align-items: center; }
.photo-picker { display: grid; place-items: center; min-height: 180rpx; margin-top: 22rpx; border: 2rpx dashed #ddcfc7; border-radius: 20rpx; color: #806f68; }
.photo-preview { width: 100%; height: 280rpx; border-radius: 18rpx; }
.submit-button { width: 100%; margin-top: 34rpx; }
