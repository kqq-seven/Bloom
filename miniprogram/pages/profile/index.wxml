<view class="page-shell">
  <view class="topbar"><text class="wordmark">Bloom</text><text>我的</text></view>
  <view class="card account-card"><view class="account-avatar">{{avatarText}}</view><text class="account-name">{{nickname}}</text></view>
  <view class="stats-card"><view><text class="stat-label">手记</text><text class="stat-value">{{stats.notes}}</text></view><view><text class="stat-label">里程碑</text><text class="stat-value">{{stats.milestones}}</text></view><view><text class="stat-label">完成待办</text><text class="stat-value">{{stats.tasks}}</text></view></view>
  <view class="link-list"><view data-module="notes" bindtap="openSpace">我的手记 <text>›</text></view><view data-module="growth" bindtap="openSpace">我的里程碑 <text>›</text></view><view bindtap="openStorage">我的收纳 <text>›</text></view></view>
  <form wx:if="{{!passwordSet}}" class="card password-card" bindsubmit="savePassword"><text class="section-title">设置登录密码</text><text class="muted">为之前已进入的昵称账号添加密码。</text><input class="password-input" name="password" type="password" minlength="8" maxlength="128" placeholder="至少 8 个字符" /><button class="primary password-button" form-type="submit">保存密码</button></form>
  <button class="secondary signout" loading="{{signingOut}}" bindtap="signOut">退出登录</button>
  <text wx:if="{{error}}" class="hint error">{{error}}</text>
</view>
