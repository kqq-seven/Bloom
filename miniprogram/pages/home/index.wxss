.home-heading { display: flex; align-items: center; justify-content: space-between; margin: 16rpx 0 35rpx; }
.home-heading .wordmark, .home-heading .greeting, .home-heading .muted { display: block; }
.home-heading .greeting { margin: 22rpx 0 6rpx; font-size: 40rpx; font-weight: 700; }
.avatar { display: grid; place-items: center; width: 74rpx; height: 74rpx; border-radius: 50%; color: #894838; background: #f8ded6; font-size: 32rpx; font-weight: 700; }
.empty-start { display: flex; flex-direction: column; align-items: flex-start; gap: 15rpx; padding: 30rpx; border-radius: 26rpx; background: #f7eee8; }
.empty-flower { display: grid; place-items: center; width: 68rpx; height: 68rpx; border-radius: 50%; background: #dcefe5; color: #476257; font-size: 42rpx; }
.empty-title { font-size: 34rpx; font-weight: 700; }
.empty-copy { line-height: 1.6; }
.compact { min-height: 72rpx; padding: 0 26rpx; line-height: 72rpx; font-size: 24rpx; }
.cycle-reminder { display: flex; align-items: center; gap: 17rpx; margin-top: 24rpx; padding: 22rpx; border-radius: 24rpx; background: #f8ded6; }
.cycle-icon { display: grid; flex: none; place-items: center; width: 58rpx; height: 58rpx; border-radius: 50%; background: #fff9f5; color: #894838; font-size: 38rpx; }
.cycle-reminder-copy { display: flex; flex: 1; flex-direction: column; align-items: flex-start; gap: 8rpx; }
.cycle-reminder-title { font-size: 27rpx; font-weight: 700; }
.cycle-reminder-note { color: #765b51; font-size: 22rpx; line-height: 1.5; }
.arrow { color: #9b7c6e; font-size: 40rpx; }
.module-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.module-card { min-height: 238rpx; display: flex; flex-direction: column; align-items: flex-start; padding: 20rpx; border-radius: 24rpx; background: #fffdfa; box-shadow: 0 7rpx 22rpx rgba(74,47,35,.045); }
.module-icon { display: grid; place-items: center; width: 56rpx; height: 56rpx; margin-bottom: 14rpx; border-radius: 50%; font-size: 32rpx; font-weight: 700; }
.cycle-icon-bg { background: #f8ded6; color: #894838; }
.task-icon-bg { background: #dcefe5; color: #476257; }
.note-icon-bg { background: #f2e7df; color: #894838; }
.module-title { font-size: 28rpx; font-weight: 700; }
.module-copy { margin-top: 8rpx; color: #806f68; font-size: 22rpx; line-height: 1.5; }
.module-link { margin-top: auto; padding-top: 16rpx; color: #894838; font-size: 21rpx; font-weight: 650; }
.latest-note { display: flex; flex-direction: column; gap: 12rpx; margin-top: 25rpx; padding: 24rpx; border-radius: 24rpx; background: #f7eee8; }
.latest-note-copy { font-family: Georgia, "Songti SC", serif; font-size: 29rpx; font-weight: 650; line-height: 1.5; }
